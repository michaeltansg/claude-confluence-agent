# Confluence API Configuration
CONFLUENCE_BASE_URL=https://your-domain.atlassian.net
CONFLUENCE_USERNAME=your-email@example.com
CONFLUENCE_API_TOKEN=your-api-token
CONFLUENCE_CLOUD=true

# Optional: Default space key for operations
CONFLUENCE_DEFAULT_SPACE=

#
# Choose between direct Claude API access or LiteLLM Proxy
# Direct Claude API Configuration requires ANTHROPIC_API_KEY
# LiteLLM Proxy Configuration requires ANTHROPIC_BASE_URL and ANTHROPIC_AUTH_TOKEN
# Comment out the unused configuration because both cannot be used simultaneously.
#

# Claude API Configuration
ANTHROPIC_API_KEY=your-anthropic-api-key

# LiteLLM Proxy Configuration
ANTHROPIC_BASE_URL="http://localhost:4000/anthropic"
ANTHROPIC_AUTH_TOKEN="your-litellm-api-key"

# Claude Model
CLAUDE_MODEL=claude-sonnet-4-20250514

# Agent Configuration
SKILLS_DIRECTORY=skills
ALLOWED_TOOLS=Skill,Read,Write,Bash
MAX_TOKENS=4096
